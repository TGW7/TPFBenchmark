{
  "name": "tpf-hrs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hybrid Readiness Score (HRS) — fitness-benchmarking engine + app for CrossFit / hybrid athletes. Standalone off-shoot of the Operational Readiness Score (ORS).",
  "scripts": {
    "codegen": "node scripts/codegen.mjs && node scripts/codegen-operator.mjs",
    "seed": "node scripts/seed-standards.mjs",
    "build:operator-standards": "node scripts/build-operator-standards.mjs",
    "predev": "npm run codegen",
    "dev": "vite",
    "prebuild": "npm run codegen",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/build-seo.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:supabase": "node --env-file=.env.local scripts/check-supabase.mjs",
    "recalibrate": "node --env-file=.env.local scripts/recalibrate.mjs",
    "recalibrate:operator": "node --env-file=.env.local scripts/recalibrate-operator.mjs",
    "publish-standards": "node --env-file=.env.local scripts/publish-standards.mjs"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@supabase/supabase-js": "^2.110.9",
    "@vercel/analytics": "^1.3.1",
    "posthog-js": "^1.407.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
